package main

import (
	"encoding/json"
	"fmt"
	"os"

	agentpkg {{.ModuleQuote}}
)

func main() {
	pkg, err := agentpkg.Package()
	if err == nil {
		encoder := json.NewEncoder(os.Stdout)
		encoder.SetIndent("", "  ")
		err = encoder.Encode(pkg.Manifest())
	}
	if err != nil { fmt.Fprintln(os.Stderr, err); os.Exit(1) }
}
