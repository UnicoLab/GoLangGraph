package agentpkg

import (
	"encoding/json"
	"testing"

	"github.com/UnicoLab/GoLangGraph/pkg/agentspec"
)

func TestPackageContract(t *testing.T) {
	pkg, err := Package()
	if err != nil { t.Fatal(err) }
	data, err := json.Marshal(pkg.Manifest())
	if err != nil { t.Fatal(err) }
	if _, err := agentspec.ParseManifest(data); err != nil { t.Fatal(err) }
	for _, definition := range pkg.Definitions() {
		if err := definition.ValidateInput(json.RawMessage(`{"message":"hello"}`)); err != nil { t.Fatal(err) }
		if err := definition.ValidateInput(json.RawMessage(`{"message":""}`)); err == nil { t.Fatal("empty message accepted") }
		if err := definition.ValidateInput(json.RawMessage(`{"unknown":true}`)); err == nil { t.Fatal("unknown field accepted") }
	}
}
